# Copy to .env and fill in from contracts/deployments/<network>.json.

VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat
VITE_RPC_URL=http://127.0.0.1:8545
# VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Robinhood Chain mainnet, for reference:
# VITE_CHAIN_ID=4663
# VITE_CHAIN_NAME=Robinhood Chain
# VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

VITE_WHALE_TOKEN=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_WHALES=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VITE_TRENCH=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
VITE_REGISTRY=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# How often to re-read the pot, in milliseconds.
VITE_POLL_MS=12000

# tokenURI returns ipfs://<cid>/0042.json, which a browser cannot fetch and an
# <img src> cannot load. Every ipfs:// URI — the metadata and the image inside
# it — goes through this gateway. Point it at your own rather than a public one:
# it is the only part of the art path that is somebody else's server.
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# How far back the portfolio ledger looks for Hauled logs. Robinhood Chain makes
# a block every 100ms, so this is a window, not all history; the all-time totals
# beside it come from the contract's own counters.
VITE_LOG_LOOKBACK=500000

# Dollar figures. Any JSON endpoint works; VITE_PRICE_PATH is the dotted path
# to the number inside the response. Leave VITE_PRICE_URL unset and the
# dashboard shows ETH only rather than inventing a price.
# VITE_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd
# VITE_PRICE_PATH=ethereum.usd

# Footer links. Anything unset is simply not rendered — never a dead link.
# VITE_X_URL=https://x.com/...
# VITE_OPENSEA_URL=https://opensea.io/collection/...
# VITE_DOCS_URL=https://github.com/.../blob/main/README.md
